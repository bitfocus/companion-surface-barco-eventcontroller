# Barco event controller (EC-50, EC-30) keyboard: Companion surface module
#
# The keyboard is an FTDI chip with Barco's own USB vendor id (0x0600), so the ftdi_sio kernel
# driver never binds and libusb can open it directly. This only grants access. It is the
# same rule Barco ships as barcoipusb.rules, plus uaccess for a logged-in desktop user.
#
# Install:
#   sudo cp 99-barco-eventcontroller.rules /etc/udev/rules.d/
#   sudo udevadm control --reload-rules && sudo udevadm trigger
#   then unplug and replug the console

SUBSYSTEM=="usb", ATTR{idVendor}=="0600", MODE="0666", GROUP="plugdev", TAG+="uaccess"
